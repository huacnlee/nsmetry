{
  "name": "NsMetry",
  "id": "dev.nsmetry.app",
  "version": "0.1.1",
  "build": 1,
  "entry": "app/App.tsx",
  "appearance": "system",
  "theme": "app/theme.json",
  "capabilities": {
    "network": {
      "hosts": [
        "*"
      ]
    },
    "clipboard": true,
    "application": true,
    "openUrl": {
      "schemes": [
        "https",
        "mailto"
      ]
    }
  },
  "dependencies": {
    "nsh-icon": "^0.2.1",
    "nsh-icon-lucide": "^0.2.1",
    "nsmetry": {
      "path": "sdk/nsh"
    }
  }
}
