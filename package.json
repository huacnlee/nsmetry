{
  "name": "nsmetry",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Privacy-first app and web analytics for a personal fleet, self-hosted on Cloudflare's free plan.",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.mjs",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node scripts/seed.mjs",
    "build:map": "node scripts/build-map.mjs",
    "build:web": "sh app/build-web.sh",
    "test:sdk": "cd sdk/js && npm test"
  },
  "dependencies": {
    "hono": "^4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@types/node": "^26.1.2",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4"
  }
}
